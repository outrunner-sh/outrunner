FROM node:26-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git tmux sqlite3 ca-certificates && rm -rf /var/lib/apt/lists/*
ARG RUNTIME_UID=1001
ARG RUNTIME_GID=1001
RUN groupmod -g "$RUNTIME_GID" node && usermod -u "$RUNTIME_UID" -g "$RUNTIME_GID" node
COPY computer.mjs /opt/computer.mjs
USER node
ENTRYPOINT ["node", "/opt/computer.mjs"]

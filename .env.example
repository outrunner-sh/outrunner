# Runtime — configuration. Copy to .env.local for development.
#
# Runtime is multi-user: each person signs in with their own GitHub account and
# supplies their own Claude credential in Settings. Those are NOT set here —
# they are stored per user, encrypted, in the database. What remains below is
# shared infrastructure that every developer on the project points at.

# --- Provider selection -----------------------------------------------------
# `daytona` is the real backend: one always-on Runtime Computer per project.
# `neev` is the same on NeevCloud Agent Sandboxes (the NEEV_* keys below).
# `local` executes workspaces in a directory on this machine (no cloud spend).
# `modal` is the legacy workspace-per-sandbox backend.
RUNTIME_PROVIDER=daytona

# REQUIRED. The app's own origin. Mutations refuse a request whose Origin does
# not match this, so it must be exactly how you reach the app in the browser.
RUNTIME_BASE_URL=http://localhost:3000

# Optional. Previews (docs/previews.md): `<slug>.<domain>` reaches a server on
# a session's box, behind sign-in. A domain of its own, never under the app's
# (the app refuses one that is). Unset, previews are off. In development,
# `localhost:3000` serves them at http://<slug>.localhost:3000.
RUNTIME_PREVIEW_DOMAIN=

# --- Supabase (shared) ------------------------------------------------------
# From Supabase → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_… or the legacy anon JWT). Public by design —
# it ships to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_… or the legacy service_role JWT). SERVER ONLY: it
# bypasses RLS, and it is the only way to reach the user_credentials table.
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption --------------------------------------------------
# REQUIRED. AES-256-GCM key that seals each user's stored GitHub and Claude
# credentials. 32 bytes: `openssl rand -base64 32`.
#
# Everyone sharing a Supabase project MUST use the SAME value. A different key
# cannot open credentials written under another one — the app treats that as
# "not connected" and asks the user to reconnect, silently.
CREDENTIALS_ENCRYPTION_KEY=

# --- Daytona (shared compute) -----------------------------------------------
DAYTONA_API_KEY=
# Optional — defaults to the SDK's https://app.daytona.io/api.
DAYTONA_API_URL=
# Optional region/target for new sandboxes (e.g. us, eu).
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=runtime-computer-v1
# The reconciler deletes the account's boxes no row names (orphans) once they
# are 2 hours quiet, but only those labelled with this deployment
# (RUNTIME_BASE_URL's host). Set to 1 only where the account is this
# deployment's alone, to delete unlabelled ones (made before the label) too;
# unset, they're only logged. A box made under another host (a domain move)
# counts as another deployment's, and is never swept.
ORPHAN_SWEEP_UNLABELLED=
# Path to the cross-compiled agent uploaded on provision. Defaults to
# .context/build/runtime-agent-linux-amd64 — build it with scripts/build-agent.sh
# BEFORE creating a workspace, or provisioning fails.
RUNTIME_AGENT_BINARY_PATH=

# --- Neev (shared compute, RUNTIME_PROVIDER=neev) ---------------------------
# A project API key with Resource Type "Sandboxes" (sk-nc-…); a personal access
# token is refused inside the sandbox. SERVER ONLY. The app reaches the agent
# through each sandbox's own runtime with it, never a preview URL.
NEEV_API_KEY=
NEEV_ORG_ID=
NEEV_PROJECT_ID=
# Optional — defaults to sb-ubuntu-26-04-dev.
NEEV_SANDBOX_TEMPLATE=

# --- Billing ----------------------------------------------------------------
# "off": no one pays and everyone is on the Free plan's limits. "stripe": plans
# come from Stripe subscriptions, and STRIPE_* below are required. Defaults to
# "off" in development; REQUIRED in production, where the server refuses to
# start without it.
RUNTIME_BILLING=off
# Stripe (test-mode keys outside production). A restricted key needs write on
# Customers, Checkout Sessions, Customer portal and Subscriptions, read on
# Prices, and write on Invoice Items and Invoices for overage billing. Locally,
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints the
# webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "on" bills usage past a plan's included amount to Stripe (overage; see
# docs/billing-overage.md). Off by default, until Stripe is set up for it.
RUNTIME_OVERAGE_BILLING=
# Bearer token for POST /api/billing/reconcile, which the Cloudflare cron
# calls every 2 minutes to meter cloud usage and pause idle boxes. Any long
# random string (`openssl rand -base64 32`). Unset: no reconciler.
BILLING_CRON_SECRET=

# --- Linear (issues into triage) ---------------------------------------------
# The Linear app's OAuth client and its webhook's signing secret. Any unset:
# Linear can't be connected. docs/linear-app.md sets the app up.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# --- Jira (issues into triage) -----------------------------------------------
# The Jira app's OAuth client, whose secret also signs its webhooks. Any unset:
# Jira can't be connected. docs/jira-app.md sets the app up.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Slack (triage capture) -------------------------------------------------
# The Slack app's signing secret (Basic Information → App Credentials). Unset:
# Slack capture is off. docs/slack-app.md sets the app up.
SLACK_SIGNING_SECRET=
# The same app's Client ID and Client Secret: connecting a Slack user to an
# account signs in with Slack. Unset: no one can connect.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The Slack agent: the OpenRouter model it thinks with (default
# anthropic/claude-sonnet-5.5). It runs on the org's key for Outrunner's models,
# within the org's plan allowance.
SLACK_AGENT_MODEL=

# --- Mission spend (docs/mission-spend.md) ----------------------------------
# Optional. Prices (USD per million tokens) for models the built-in cost basis
# doesn't list, versioned; their spend is otherwise "unavailable", never $0:
# {"version":"or-2026-11","models":{"z-ai/glm-5.3":{"input":0.5,"output":2}}}
MISSION_COST_BASIS=
# Optional. A USD rate for one Small-box compute hour, versioned, shown as an
# estimate beside the hours: {"version":"daytona-2026-11","usdPerHour":0.1}
MISSION_COMPUTE_RATE=

# --- GitHub (docs/github-app.md) -------------------------------------------
# The Outrunner GitHub App: all four or none.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# The App's client secret. Users connect their own repositories with it
# (Settings → Connections → GitHub: the App's user authorization, whose tokens
# expire after 8 hours and renew themselves). Without it, sign-in keeps asking
# for the `repo` scope, as before.
GITHUB_APP_CLIENT_SECRET=
# The old `repo` tokens sign-in kept: `store` (the default, when unset: sign-in
# asks for `repo` and keeps its token, as before), `fallback` (still used until
# their users connect; needs the client secret set), or `off` (never used: the
# cutover).
GITHUB_LEGACY_TOKENS=
# Optional: the GitHub OAuth App Supabase signs in with (Supabase → Auth →
# Providers → GitHub). With these, an old `repo` token is revoked on GitHub
# when it's removed, and a sign-in's token once its emails are read.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Access -----------------------------------------------------------------
# OPTIONAL allowlist of GitHub logins, comma- or space-separated. Leave BLANK to
# let anyone with a GitHub account sign in. Note the polarity: blank means OPEN.
RUNTIME_OWNER_GITHUB_LOGIN=

# OPTIONAL GitHub logins exempt from plan limits only, comma- or space-separated.
# Independent of sign-in; blank means nobody is exempt and limits still apply.
RUNTIME_PLAN_LIMIT_EXEMPT_GITHUB_LOGIN=

# =====================================================================

# Optional: email org invites and requests to join, through Resend
# (lib/email/send.ts). Without these, an invite's link is shown to the admin
# to share, and requests wait on Settings → Org → Members.
RESEND_API_KEY=
EMAIL_FROM="Outrunner <hello@example.com>"

# Optional: error tracking through Sentry (lib/observability/report.ts,
# instrumentation.ts). The DSN of a Sentry project (platform: Next.js).
# Unset: errors are only logged. SENTRY_ENVIRONMENT overrides the
# environment events are tagged with (default: production / development).
SENTRY_DSN=

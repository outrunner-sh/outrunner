[Unit]
Description=Outrunner background jobs
After=outrunner.service

[Service]
Type=oneshot
User=outrunner
Group=outrunner
EnvironmentFile=/etc/outrunner/cron.env
ExecStart=/usr/bin/node /usr/local/lib/outrunner/tick.mjs
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

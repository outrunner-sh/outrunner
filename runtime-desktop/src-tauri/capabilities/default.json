{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: shell basics plus the native Claude connect commands.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "https://runtime.zerotrail.ai"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "allow-connect-claude-start",
    "allow-connect-claude-submit",
    "allow-connect-claude-cancel"
  ]
}

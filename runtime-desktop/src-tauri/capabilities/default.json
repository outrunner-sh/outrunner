{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: shell basics, the native Claude connect commands, the local agent CLI logins, the local-session relay, the import of this Mac's sessions, the sidebar's Update button, and notifications of sessions.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "https://app.outrunner.sh"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "notification:default",
    "allow-connect-claude-start",
    "allow-connect-claude-poll",
    "allow-connect-claude-submit",
    "allow-connect-claude-cancel",
    "allow-connect-claude-debug",
    "allow-local-status",
    "allow-local-claude-login",
    "allow-local-claude-login-cancel",
    "allow-local-codex-login",
    "allow-local-codex-login-cancel",
    "allow-local-claude-setup",
    "allow-local-pick-folder",
    "allow-local-check-folder",
    "allow-local-clone-repo",
    "allow-local-list-sessions",
    "allow-local-agent-request",
    "allow-local-socket-open",
    "allow-local-socket-send",
    "allow-local-socket-close",
    "allow-import-scan",
    "allow-import-session",
    "allow-import-environment",
    "allow-import-config",
    "allow-update-status",
    "allow-restart-to-update"
  ]
}

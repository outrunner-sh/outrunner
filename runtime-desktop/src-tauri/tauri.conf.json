{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outrunner",
  "version": "0.1.0",
  "identifier": "ai.neev.outrunner",
  "build": {
    "beforeDevCommand": "bun run agent && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run agent && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["runtime"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/runtime-agent"
    ]
  }
}

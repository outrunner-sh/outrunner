{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outrunner",
  "version": "0.1.0",
  "identifier": "ai.zerotrail.runtime",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["runtime"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/neevai-labs/outrunner/releases/latest/download/latest.json"
      ],
      "pubkey": "PASTE_TAURI_UPDATER_PUBLIC_KEY_HERE"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  }
}

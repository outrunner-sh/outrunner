{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "outrunner",
  "version": "0.1.0",
  "identifier": "ai.neev.outrunner",
  "build": {
    "beforeDevCommand": "bun run sidecars && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecars && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["runtime"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNUVGMkYyMEVGRUUyMEEKUldRSzR2NE84dkplTCtGYkJLcTNWRjlLSlpaVlZXdXZ2cUtDenpFZ2Z0a1pDMVNTZEduYUVHeSsK",
      "endpoints": ["https://downloads.outrunner.sh/outrunner/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 Outrunner, Inc.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/runtime-agent",
      "binaries/tmux"
    ],
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../licenses/": "licenses/licenses/",
      "../../public/fonts/OFL.txt": "licenses/public/fonts/OFL.txt"
    }
  }
}

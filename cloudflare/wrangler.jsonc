{
  // Cloudflare Containers deployment for the Outrunner control plane.
  // Deploy tooling only — the application is unchanged.
  //
  // The `containers` schema + @cloudflare/containers API move fast; verify field
  // names against the current Cloudflare Containers docs before the first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outrunner",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "573a49a12e65fd8fc97b0103fa200d36",

  // Build context is the outrunner/ directory (the Dockerfile there builds the
  // Go agent binary + the Next app).
  "containers": [
    {
      "class_name": "OutrunnerControlPlane",
      "image": "../Dockerfile",
      // Build-time only. NEXT_PUBLIC_* is inlined into the client bundle by
      // `next build`, so the Worker's runtime env never reaches the browser —
      // without these the page loads and the client Supabase constructor throws.
      // Both are shipped to every visitor by design, so they are not secrets;
      // the service-role key and CREDENTIALS_ENCRYPTION_KEY stay Worker secrets.
      "image_vars": {
        "NEXT_PUBLIC_CODEX_CLI_VERSION": "0.1.4",
        "NEXT_PUBLIC_SUPABASE_URL": "https://butbnitdpiehgwqggowr.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_PzZINFybWQAKwQlBqs2qsg_4SNlVTMj"
      },
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],

  // Which deploy is running, so the control plane's container is replaced by
  // the first request after a deploy (worker.ts, runCurrentImage).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Kept logs (Workers Logs), the container's output among them: without
  // them a session's setup that stopped partway left nothing to read once
  // it had happened. Sampled in full; the control plane logs little.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "durable_objects": {
    "bindings": [
      { "name": "CONTROL_PLANE", "class_name": "OutrunnerControlPlane" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OutrunnerControlPlane"] }
  ],

  // The reconciler: keeps cloud hours and pauses idle boxes (worker.ts,
  // scheduled). Needs the BILLING_CRON_SECRET secret.
  "triggers": { "crons": ["*/2 * * * *"] },

  // Serves the app at app.outrunner.sh. Deploying creates/points each DNS entry
  // in its zone, so both zones must be in this account. outrunner.neev.ai, the
  // old domain, stays bound only to redirect to the new one (worker.ts), for
  // bookmarks and Mac apps from before the move. See docs/deploy-cloudflare.md.
  //
  // Previews (lib/previews) live on a domain of their own, never under
  // outrunner.sh: a preview runs the session's code in the visitor's
  // browser, which mustn't share a site with the app. Once its zone is in
  // this account with a proxied wildcard DNS record (`*`, AAAA 100::), add
  // its route below and set RUNTIME_PREVIEW_DOMAIN under "vars" (a custom
  // domain can't be a wildcard, hence a zone route). See
  // docs/deploy-cloudflare.md#previews.
  //   { "pattern": "*.<preview domain>/*", "zone_name": "<preview domain>" }
  "routes": [
    { "pattern": "app.outrunner.sh", "custom_domain": true },
    { "pattern": "outrunner.neev.ai", "custom_domain": true }
  ]
}

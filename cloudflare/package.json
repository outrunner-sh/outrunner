{
  "name": "outrunner-cloudflare",
  "private": true,
  "type": "module",
  "description": "Cloudflare Containers deploy tooling for the Outrunner control plane. Isolated from the app so it never touches the app's lockfile or Docker build.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260929.1",
    "typescript": "^5.9.3",
    "wrangler": "^4"
  },
  "author": "Outrunner, Inc.",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "undici@<7.30.1": "^7.30.1",
      "sharp@<0.35.5": "^0.35.5"
    }
  }
}

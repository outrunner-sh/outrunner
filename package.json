{
  "name": "runtime",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/test-loader.mjs --test \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:status": "bash scripts/db-migrate.sh status",
    "db:repair": "bash scripts/db-migrate.sh repair"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.203.0",
    "@neevcloud/sdk": "^0.8.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "form-data": "^4.0.6",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.552.0",
    "modal": "^0.11.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}

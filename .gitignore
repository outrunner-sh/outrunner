# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/test/browser/.next/
/test/browser/next-env.d.ts
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Cloudflare's local state and generated bundles
/cloudflare/.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch artifacts (screenshots, recordings, and uploaded attachments)
/artifacts/
/.artifacts/
/.hoplite/attachments/
/.hoplite/archive/

# runtime-agent build artifacts
/runtime-agent/runtime-agent
bun.lock


# Cross-compiled agent binary — build with scripts/build-agent.sh, not committed.
bin/runtime-agent-linux-amd64
# Default build-agent.sh output dir (scripts/build-agent.sh calls it gitignored).
/.context/

# macOS agent sidecars — build with scripts/build-agent-desktop.sh, not committed.
/runtime-desktop/src-tauri/binaries/

# Supabase CLI local cache (linked project, CLI version)
supabase/.temp/
